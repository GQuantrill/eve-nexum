{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexum",
  "version": "0.1.6",
  "identifier": "com.evenexum.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English",
          "German",
          "Dutch",
          "French",
          "Spanish",
          "Portuguese",
          "SimpChinese",
          "Korean",
          "Japanese",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QzE2MkZEQjM0NkFDMTEKUldRUnJFYXovV0xCcUR4Y1o0MHpPNUFlMlU2VlFVd08zZnI0QU9rcTN3NVpQY2FyU2ViT25LTUEK",
      "endpoints": [
        "https://github.com/GQuantrill/nexum-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
